# Copy this file to config.toml and fill in your values.
# SECURITY: config.toml is git-ignored. Never commit your real values.
# A leaked bot_token lets anyone send commands to your device and trigger /send
# from your SIM card. If leaked, revoke it immediately via @BotFather.
#
# ALTERNATIVE (no fork required): leave wifi/im/modem credentials blank here.
# On first boot the device will prompt for credentials over the serial console.
# Credentials are saved to NVS and survive reboots. To re-provision, erase NVS:
#   espflash erase-region 0x9000 0x6000

[wifi]
ssid     = "YOUR_WIFI_SSID"
password = "YOUR_WIFI_PASSWORD"  # DO NOT COMMIT

[im]
backend   = "telegram"
bot_token = "123456:ABC-DEF..."  # DO NOT COMMIT — revoke at @BotFather if leaked
chat_id   = 987654321            # Your Telegram user ID (not a group ID)
# Additional private chats allowed to issue commands. Command replies return to
# the caller; SMS and other notifications still go to chat_id.
trusted_chat_ids = []

[modem]
# LilyGo T-A7670X R2: TX=26, RX=27, PWRKEY=4
# LilyGo T-A7670X S3 Standard (H799): TX=4, RX=5, PWRKEY=46
uart_tx   = 26
uart_rx   = 27
uart_baud = 115200
pwrkey    = 4
# Packet-switched attachment (LTE/GPRS “data”). Default off — SMS/voice use CS / NAS; WiFi carries HTTPS.
cellular_data = false
# If WiFi fails after retries, attach PDP and use modem HTTPS for Telegram (same UART as SMS — use short poll timeouts).
cellular_fallback = false
# Keep packet data off for SMS-only deployments. If the modem/network auto-activates
# a PDP context while roaming, the firmware deactivates it again.
disable_cellular_data = true
apn       = ""
apn_user  = ""
apn_pass  = ""
# Optional 4-8 digit SIM PIN. Leave empty for an unlocked SIM. Do not commit a real PIN.
sim_pin   = ""

[bridge]
max_failures_before_reboot = 8
poll_interval_ms           = 3000
watchdog_timeout_sec       = 120

# Extra delivery sinks (optional). SMS is forwarded to Telegram AND each sink.
# Each [[sink]] entry opens a fresh connection per message (no idle RAM cost).
#
# [[sink]]
# type = "webhook"
# url  = "https://example.com/hook/sms"
#
# [[sink]]
# type = "webhook"
# url  = "http://192.168.1.100:8080/mq/publish"

[ota]
# HTTPS URL to the firmware .bin file. Typically a GitHub Releases asset.
# Leave empty to disable OTA entirely (the /update command will report "disabled").
url = ""
# "auto" — confirm immediately after successful boot (no rollback window)
# "manual" — wait for /update confirm within 5 min, otherwise rollback on reboot
confirm = "auto"

[ui]
# Locale: "en" (default) or "zh"
# locale = "zh"
